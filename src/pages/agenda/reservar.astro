---
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/Icon.astro';
import {
  ALERT_ERROR,
  BUTTON_PRIMARY,
  BUTTON_SECONDARY,
  FIELD,
  HINT,
  LABEL,
} from '../../components/app/formStyles';
import { db } from '../../db';
import { appointments } from '../../db/schema';
import {
  isSlotTaken,
  listActiveServices,
  listAvailabilityRules,
  listBlackoutsOverlapping,
  listPatients,
  listPendingAtSlot,
} from '../../lib/agenda';
import { isUniqueViolation } from '../../lib/http';
import { adminBookingSchema, bookingSchema, firstIssue } from '../../lib/validation';
import { formatFull, formatTime, isValidSlotStart, toISODate, todayInClinic } from '../../lib/schedule';

const { user } = Astro.locals;
if (!user) return Astro.redirect('/ingresar', 303);

/**
 * Administración también carga turnos desde acá, en nombre de un paciente:
 * el consultorio necesita poder dar de alta un turno que llega por teléfono.
 */
const isAdmin = user.role === 'admin';

const rawStart =
  Astro.request.method === 'POST' ? null : Astro.url.searchParams.get('inicio');

let error: string | null = null;
let startsAt: Date | null = null;
let slotMinutes = 30;
let notes = '';
let selectedServiceId = '';
let selectedPatientId = '';
let confirmarDirecto = false;

const services = await listActiveServices();
const rules = await listAvailabilityRules();
const patients = isAdmin ? await listPatients() : [];

/**
 * Valida un instante recibido del cliente. No basta con que sea una fecha:
 * tiene que caer exactamente en un hueco de la grilla, estar en el futuro y no
 * pisar un cierre. Si no, alguien podría reservar a cualquier hora manipulando
 * el parámetro.
 *
 * Que haya solicitudes pendientes NO lo invalida: un pendiente es una
 * solicitud, no una reserva. Solo un turno confirmado cierra el horario.
 */
async function resolveSlot(value: string): Promise<{ startsAt: Date; slotMinutes: number } | string> {
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return 'El horario indicado no es válido.';

  const rule = isValidSlotStart(parsed, rules);
  if (!rule) return 'Ese horario no forma parte de la agenda de atención.';

  if (parsed.getTime() <= Date.now()) return 'Ese horario ya pasó. Elegí uno futuro.';

  const endsAt = new Date(parsed.getTime() + rule.slotMinutes * 60000);
  const overlapping = await listBlackoutsOverlapping(parsed, endsAt);
  if (overlapping.length > 0) {
    return 'El consultorio está cerrado en ese horario.';
  }

  if (await isSlotTaken(parsed)) return 'Ese horario ya tiene un turno confirmado. Elegí otro.';

  return { startsAt: parsed, slotMinutes: rule.slotMinutes };
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  notes = String(form.get('notes') ?? '');
  selectedServiceId = String(form.get('serviceId') ?? '');
  selectedPatientId = String(form.get('patientId') ?? '');
  confirmarDirecto = String(form.get('confirmar') ?? 'no') === 'si';

  const rawSubmitted = String(form.get('startsAt') ?? '');

  /**
   * El horario se resuelve ANTES de validar el resto del formulario.
   *
   * Si no, un error en cualquier campo dejaba `startsAt` en null y la pagina
   * ocultaba el formulario entero: se perdia lo cargado y no habia forma de
   * corregir sin volver al calendario.
   */
  const preview = await resolveSlot(rawSubmitted);
  if (typeof preview !== 'string') {
    startsAt = preview.startsAt;
    slotMinutes = preview.slotMinutes;
  }

  const base = {
    startsAt: rawSubmitted,
    serviceId: selectedServiceId,
    notes,
  };

  const parsed = isAdmin
    ? adminBookingSchema.safeParse({
        ...base,
        patientId: selectedPatientId,
        confirmar: confirmarDirecto ? 'si' : 'no',
      })
    : bookingSchema.safeParse(base);

  if (!parsed.success) {
    error = firstIssue(parsed.error);
  } else if (!services.some((service) => service.id === parsed.data.serviceId)) {
    error = 'Elegí una especialidad válida.';
  } else {
    /**
     * De quién es el turno. Para un paciente, de sí mismo, sin excepción. Para
     * administración, del paciente elegido, comprobado contra la lista real:
     * un UUID válido no garantiza que exista ni que sea un cliente.
     */
    let ownerId = user.id;

    if (isAdmin) {
      // `patientId` solo existe en el esquema de administración; el union de
      // ambos esquemas no lo declara, de ahí el acceso explícito.
      const chosenId = 'patientId' in parsed.data ? parsed.data.patientId : '';
      const chosen = patients.find((p) => p.id === chosenId);
      if (!chosen) {
        error = 'Elegí un paciente de la lista.';
      } else {
        ownerId = chosen.id;
      }
    }

    if (!error) {
      // Se revalida el horario aunque ya se resolvió arriba: entre una cosa y
      // otra alguien pudo confirmar un turno en ese hueco.
      const resolved = await resolveSlot(parsed.data.startsAt);

      if (typeof resolved === 'string') {
        error = resolved;
      } else {
        startsAt = resolved.startsAt;
        slotMinutes = resolved.slotMinutes;

        try {
          await db.insert(appointments).values({
            userId: ownerId,
            serviceId: parsed.data.serviceId,
            startsAt: resolved.startsAt,
            endsAt: new Date(resolved.startsAt.getTime() + resolved.slotMinutes * 60000),
            // Solo administración puede confirmar de una; un paciente solicita.
            status: isAdmin && confirmarDirecto ? 'confirmed' : 'pending',
            notes: parsed.data.notes,
          });

          return Astro.redirect(
            isAdmin ? '/admin?cargado=1' : '/mis-turnos?solicitado=1',
            303,
          );
        } catch (cause) {
          // El índice único parcial rechazó el turno: ya hay uno confirmado.
          if (isUniqueViolation(cause)) {
            error = 'Ese horario acaba de recibir un turno confirmado. Elegí otro.';
          } else {
            throw cause;
          }
        }
      }
    }
  }
} else if (rawStart) {
  const resolved = await resolveSlot(rawStart);
  if (typeof resolved === 'string') {
    error = resolved;
  } else {
    startsAt = resolved.startsAt;
    slotMinutes = resolved.slotMinutes;
  }
} else {
  error = 'No indicaste ningún horario.';
}

const backHref = startsAt
  ? `/agenda?semana=${toISODate(todayInClinic(startsAt))}`
  : '/agenda';
const endsAt = startsAt ? new Date(startsAt.getTime() + slotMinutes * 60000) : null;

/**
 * Solicitudes que ya compiten por este horario. Se muestran para que quien
 * solicita sepa que no es el único, y para que administración vea a quién más
 * dejaría afuera al confirmar.
 */
const competencia = startsAt ? await listPendingAtSlot(startsAt) : [];
const propias = competencia.filter((item) => item.userId === user.id).length;

/**
 * El formulario de abajo NO lleva `novalidate`, a diferencia del resto de la
 * aplicacion: aqui no hay JavaScript que muestre los errores, asi que conviene
 * que el navegador avise de los campos obligatorios antes de enviar. La
 * validacion del servidor sigue siendo la que manda.
 */
---

<AppLayout title="Confirmar turno" user={user}>
  <div class="mx-auto max-w-xl">
    <a
      href={backHref}
      class="inline-flex items-center gap-2 text-sm font-medium text-ink-500 transition-colors hover:text-brand-700"
    >
      <Icon name="arrowLeft" class="h-4 w-4" />
      Volver al calendario
    </a>

    <h1 class="mt-5 text-3xl font-semibold tracking-tight text-ink-900">Confirmar solicitud</h1>

    {
      error && (
        <p class={`mt-6 ${ALERT_ERROR}`} role="alert">
          <Icon name="alert" class="mt-0.5 h-4 w-4 shrink-0" />
          <span>{error}</span>
        </p>
      )
    }

    {
      startsAt && endsAt ? (
        <form method="POST" class="mt-6 space-y-6">
          <input type="hidden" name="startsAt" value={startsAt.toISOString()} />

          <div class="rounded-2xl border border-brand-200 bg-brand-50 p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">
              Horario elegido
            </p>
            <p class="mt-2 text-lg font-semibold capitalize text-ink-900">{formatFull(startsAt)}</p>
            <p class="mt-1 text-sm text-ink-500">
              Duración estimada: {slotMinutes} minutos (hasta las {formatTime(endsAt)})
            </p>
          </div>

          {competencia.length > 0 && (
            <div class="rounded-2xl border border-amber-300 bg-amber-50 p-5 text-sm leading-relaxed text-amber-800">
              <p class="font-semibold">
                {competencia.length === 1
                  ? 'Ya hay 1 solicitud para este horario'
                  : `Ya hay ${competencia.length} solicitudes para este horario`}
                {propias > 0 && !isAdmin && ' (incluida la tuya)'}
              </p>
              {isAdmin ? (
                <ul class="mt-2 space-y-1">
                  {competencia.map((item) => (
                    <li>
                      {item.patientName} <span class="opacity-75">· {item.serviceName}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="mt-1">
                  El horario sigue disponible: podés solicitarlo igual. El consultorio confirma una
                  sola y avisa al resto.
                </p>
              )}
            </div>
          )}

          {isAdmin && (
            <div>
              <label class={LABEL} for="patientId">Paciente</label>
              <select class={`mt-2 ${FIELD}`} id="patientId" name="patientId" required>
                <option value="" disabled selected={!selectedPatientId}>
                  Seleccioná un paciente
                </option>
                {patients.map((patient) => (
                  <option value={patient.id} selected={selectedPatientId === patient.id}>
                    {patient.fullName} — {patient.phone}
                  </option>
                ))}
              </select>
              <p class={HINT}>
                {patients.length === 0
                  ? 'Todavía no hay pacientes registrados. El paciente tiene que crear su cuenta primero.'
                  : 'El turno queda asociado a esa cuenta, así el paciente lo ve en «Mis turnos».'}
              </p>
            </div>
          )}

          <div>
            <label class={LABEL} for="serviceId">Especialidad</label>
            <select class={`mt-2 ${FIELD}`} id="serviceId" name="serviceId" required>
              <option value="" disabled selected={!selectedServiceId}>
                Seleccioná una opción
              </option>
              {services.map((service) => (
                <option value={service.id} selected={selectedServiceId === String(service.id)}>
                  {service.name}
                </option>
              ))}
            </select>
          </div>

          {isAdmin && (
            <div>
              <label class={LABEL} for="confirmar">Estado del turno</label>
              <select class={`mt-2 ${FIELD}`} id="confirmar" name="confirmar">
                <option value="no" selected={!confirmarDirecto}>
                  Dejar como solicitud pendiente
                </option>
                <option value="si" selected={confirmarDirecto}>
                  Confirmar directamente
                </option>
              </select>
              <p class={HINT}>
                Confirmar directamente cierra el horario y rechaza las demás solicitudes.
              </p>
            </div>
          )}

          <div>
            <label class={LABEL} for="notes">
              Motivo de consulta <span class="font-normal text-ink-500">(opcional)</span>
            </label>
            <textarea class={`mt-2 resize-y ${FIELD}`} id="notes" name="notes" rows="3" maxlength="500"
              >{notes}</textarea
            >
            <p class={HINT}>
              Contanos brevemente qué te pasa. Evitá incluir datos que no hagan falta.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row">
            <button type="submit" class={`flex-1 ${BUTTON_PRIMARY}`}>
              <Icon name="calendar" class="h-4 w-4" />
              {isAdmin ? 'Cargar el turno' : 'Solicitar este turno'}
            </button>
            <a href={backHref} class={BUTTON_SECONDARY}>Elegir otro horario</a>
          </div>

          <p class="text-xs leading-relaxed text-ink-500">
            {
              isAdmin
                ? 'Si lo dejás pendiente, aparece en Solicitudes para confirmarlo después.'
                : 'La solicitud queda pendiente hasta que el consultorio la confirme. Vas a poder seguir su estado en «Mis turnos».'
            }
          </p>
        </form>
      ) : (
        <a href="/agenda" class={`mt-6 ${BUTTON_PRIMARY}`}>Volver a elegir un horario</a>
      )
    }
  </div>
</AppLayout>
