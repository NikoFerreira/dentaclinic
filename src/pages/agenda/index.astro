---
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import WeekCalendar from '../../components/app/WeekCalendar.astro';
import Icon from '../../components/Icon.astro';
import { ALERT_OK } from '../../components/app/formStyles';
import { loadWeekData } from '../../lib/agenda';
import { buildWeek, parseISODate, startOfWeek, todayInClinic } from '../../lib/schedule';

const { user } = Astro.locals;
// El middleware ya lo garantiza; esta guarda es para el tipado y por si acaso.
if (!user) return Astro.redirect('/ingresar', 303);

const requested = parseISODate(Astro.url.searchParams.get('semana')) ?? todayInClinic();
const weekStart = startOfWeek(requested);
const now = new Date();

const { rules, appointments, blackouts } = await loadWeekData(weekStart);

const days = buildWeek({
  weekStart,
  rules,
  appointments,
  blackouts,
  now,
  viewer: { id: user.id, role: user.role },
});

const isAdmin = user.role === 'admin';
const cancelled = Astro.url.searchParams.get('cancelado') === '1';
const freeCount = days.reduce(
  (total, day) => total + day.slots.filter((slot) => slot.state === 'free').length,
  0,
);
---

<AppLayout title="Calendario" user={user}>
  <header class="mb-8">
    <h1 class="text-3xl font-semibold tracking-tight text-ink-900">
      {isAdmin ? 'Calendario del consultorio' : 'Reservar un turno'}
    </h1>
    <p class="mt-2 max-w-2xl text-[0.975rem] leading-relaxed text-ink-500">
      {
        isAdmin
          ? 'Vista completa de la semana. Para confirmar o rechazar solicitudes, entrá a Solicitudes.'
          : 'Elegí un horario libre y enviá tu solicitud. El consultorio la confirma y te avisa.'
      }
    </p>
  </header>

  {
    cancelled && (
      <p class={`mb-6 ${ALERT_OK}`} role="status">
        <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0" strokeWidth={2} />
        <span>Tu turno fue cancelado y el horario volvió a quedar libre.</span>
      </p>
    )
  }

  {
    !isAdmin && freeCount === 0 && (
      <p class="mb-6 flex items-start gap-3 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm leading-relaxed text-amber-800">
        <Icon name="alert" class="mt-0.5 h-4 w-4 shrink-0" />
        <span>
          No quedan horarios libres esta semana. Probá con la semana siguiente usando las flechas.
        </span>
      </p>
    )
  }

  <WeekCalendar days={days} weekStart={weekStart} baseHref="/agenda" bookable={!isAdmin} />
</AppLayout>
