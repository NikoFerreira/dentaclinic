---
export const prerender = false;

import AuthLayout from '../layouts/AuthLayout.astro';
import Icon from '../components/Icon.astro';
import {
  ALERT_ERROR,
  BUTTON_PRIMARY,
  FIELD,
  LABEL,
} from '../components/app/formStyles';
import { authenticate, createSession, setSessionCookie } from '../lib/auth';
import { safeRedirect } from '../lib/http';
import { firstIssue, loginSchema } from '../lib/validation';

const { user } = Astro.locals;
if (user) {
  return Astro.redirect(user.role === 'admin' ? '/admin' : '/agenda', 303);
}

const requested = Astro.url.searchParams.get('redirigir');
let error: string | null = null;
let email = '';

/**
 * Nota sobre astro check: por el `return` temprano de arriba, el generador de
 * tipos de Astro marca el codigo posterior como inalcanzable y avisa que
 * `safeRedirect` "nunca se usa". Es un falso positivo: en ejecucion si se usa
 * (verificado por HTTP). No borrar el import.
 */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '');

  const parsed = loginSchema.safeParse({
    email,
    password: String(form.get('password') ?? ''),
  });

  if (!parsed.success) {
    error = firstIssue(parsed.error);
  } else {
    const result = await authenticate(parsed.data.email, parsed.data.password);

    if (result.ok) {
      const { token, expiresAt } = await createSession(result.user.id);
      setSessionCookie(Astro.cookies, token, expiresAt);
      const fallback = result.user.role === 'admin' ? '/admin' : '/agenda';
      return Astro.redirect(safeRedirect(requested, fallback), 303);
    }

    error =
      result.reason === 'locked'
        ? `Demasiados intentos fallidos. Volvé a probar en ${result.minutes} ${result.minutes === 1 ? 'minuto' : 'minutos'}.`
        : // Mensaje deliberadamente ambiguo: decir "el correo no existe"
          // permitiria averiguar qué cuentas están registradas.
          'Correo o contraseña incorrectos.';
  }
}

const registerHref = requested
  ? `/registro?redirigir=${encodeURIComponent(requested)}`
  : '/registro';
---

<AuthLayout
  title="Ingresar"
  heading="Ingresá a tu cuenta"
  subheading="Accedé para reservar turnos y ver el estado de tus citas."
>
  <form method="POST" class="mt-7 space-y-5" novalidate>
    {
      error && (
        <p class={ALERT_ERROR} role="alert">
          <Icon name="alert" class="mt-0.5 h-4 w-4 shrink-0" />
          <span>{error}</span>
        </p>
      )
    }

    <div>
      <label class={LABEL} for="email">Correo electrónico</label>
      <input
        class={`mt-2 ${FIELD}`}
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        value={email}
        placeholder="ana@correo.com"
        required
      />
    </div>

    <div>
      <label class={LABEL} for="password">Contraseña</label>
      <input
        class={`mt-2 ${FIELD}`}
        id="password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
      />
    </div>

    <button type="submit" class={`w-full ${BUTTON_PRIMARY}`}>Ingresar</button>
  </form>

  <p slot="footer" class="mt-6 text-center text-sm text-ink-500">
    ¿Todavía no tenés cuenta?{' '}
    <a
      href={registerHref}
      class="font-semibold text-brand-700 underline decoration-brand-200 decoration-2 underline-offset-4 hover:decoration-brand-600"
    >
      Registrate
    </a>
  </p>
</AuthLayout>
