---
export const prerender = false;

import AppLayout from '../layouts/AppLayout.astro';
import Icon from '../components/Icon.astro';
import {
  ALERT_ERROR,
  ALERT_OK,
  BUTTON_DANGER,
  BUTTON_PRIMARY,
} from '../components/app/formStyles';
import { STATUS_BADGE, STATUS_LABEL } from '../components/app/slotStyles';
import { listUserAppointments } from '../lib/agenda';
import { formatFull, formatTime } from '../lib/schedule';

const { user } = Astro.locals;
if (!user) return Astro.redirect('/ingresar', 303);

const all = await listUserAppointments(user.id);
const now = Date.now();

const upcoming = all.filter(
  (item) => item.startsAt.getTime() > now && (item.status === 'pending' || item.status === 'confirmed'),
);
const history = all
  .filter((item) => !upcoming.includes(item))
  .sort((a, b) => b.startsAt.getTime() - a.startsAt.getTime());

const params = Astro.url.searchParams;
const notices = {
  requested: params.get('solicitado') === '1',
  cancelled: params.get('cancelado') === '1',
  invalid: params.get('estado') === 'invalido',
  tooLate: params.get('estado') === 'tarde',
};
const currentPath = '/mis-turnos';
---

<AppLayout title="Mis turnos" user={user}>
  <header class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight text-ink-900">Mis turnos</h1>
      <p class="mt-2 text-[0.975rem] leading-relaxed text-ink-500">
        Seguí el estado de tus solicitudes y cancelá si no vas a poder asistir.
      </p>
    </div>
    <a href="/agenda" class={BUTTON_PRIMARY}>
      <Icon name="plus" class="h-4 w-4" />
      Reservar otro turno
    </a>
  </header>

  {
    notices.requested && (
      <p class={`mb-6 ${ALERT_OK}`} role="status">
        <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0" strokeWidth={2} />
        <span>
          Solicitud enviada. El consultorio la va a confirmar y te avisa; mientras tanto figura como
          pendiente.
        </span>
      </p>
    )
  }
  {
    notices.cancelled && (
      <p class={`mb-6 ${ALERT_OK}`} role="status">
        <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0" strokeWidth={2} />
        <span>Turno cancelado. El horario volvió a quedar disponible.</span>
      </p>
    )
  }
  {
    notices.invalid && (
      <p class={`mb-6 ${ALERT_ERROR}`} role="alert">
        <Icon name="alert" class="mt-0.5 h-4 w-4 shrink-0" />
        <span>Ese turno ya no se puede modificar porque cambió de estado.</span>
      </p>
    )
  }
  {
    notices.tooLate && (
      <p class={`mb-6 ${ALERT_ERROR}`} role="alert">
        <Icon name="alert" class="mt-0.5 h-4 w-4 shrink-0" />
        <span>
          No se puede cancelar un turno que ya pasó. Comunicate con el consultorio por teléfono.
        </span>
      </p>
    )
  }

  <section aria-labelledby="proximos-titulo">
    <h2 id="proximos-titulo" class="text-lg font-semibold tracking-tight text-ink-900">
      Próximos turnos
    </h2>

    {
      upcoming.length === 0 ? (
        <p class="mt-4 rounded-2xl border border-dashed border-ink-200 bg-white p-8 text-center text-sm text-ink-500">
          No tenés turnos próximos.{' '}
          <a href="/agenda" class="font-semibold text-brand-700 underline underline-offset-4">
            Reservá uno
          </a>
          .
        </p>
      ) : (
        <ul class="mt-4 space-y-3">
          {upcoming.map((item) => (
            <li class="rounded-2xl border border-ink-200/80 bg-white p-5">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <p class="text-base font-semibold capitalize text-ink-900">
                    {formatFull(item.startsAt)}
                  </p>
                  <p class="mt-1 text-sm text-ink-500">
                    {item.serviceName} · hasta las {formatTime(item.endsAt)}
                  </p>
                  {item.notes && (
                    <p class="mt-3 max-w-prose rounded-xl bg-page p-3 text-sm leading-relaxed text-ink-700">
                      {item.notes}
                    </p>
                  )}
                </div>

                <div class="flex flex-col items-end gap-3">
                  <span
                    class:list={[
                      'inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold',
                      STATUS_BADGE[item.status],
                    ]}
                  >
                    {STATUS_LABEL[item.status]}
                  </span>
                  <form method="POST" action={`/api/turnos/${item.id}`}>
                    <input type="hidden" name="accion" value="cancelar" />
                    <input type="hidden" name="volverA" value={currentPath} />
                    <button type="submit" class={BUTTON_DANGER}>
                      <Icon name="ban" class="h-4 w-4" />
                      Cancelar
                    </button>
                  </form>
                </div>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    history.length > 0 && (
      <section class="mt-12" aria-labelledby="historial-titulo">
        <h2 id="historial-titulo" class="text-lg font-semibold tracking-tight text-ink-900">
          Historial
        </h2>
        <ul class="mt-4 divide-y divide-ink-200/80 overflow-hidden rounded-2xl border border-ink-200/80 bg-white">
          {history.map((item) => (
            <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-4">
              <div>
                <p class="text-sm font-medium capitalize text-ink-900">{formatFull(item.startsAt)}</p>
                <p class="mt-0.5 text-sm text-ink-500">{item.serviceName}</p>
              </div>
              <span
                class:list={[
                  'inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold',
                  STATUS_BADGE[item.status],
                ]}
              >
                {STATUS_LABEL[item.status]}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</AppLayout>
