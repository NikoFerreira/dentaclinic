---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  heading: string;
  subheading: string;
}

const { title, heading, subheading } = Astro.props;
---

<!doctype html>
<html lang="es" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — DentaClinic</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0d7482" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="grid min-h-dvh place-items-center px-5 py-12">
    <main class="w-full max-w-md">
      <a href="/" class="mx-auto flex w-fit rounded-lg" aria-label="DentaClinic, ir al inicio">
        <Logo />
      </a>

      <div class="mt-8 rounded-4xl border border-ink-200/80 bg-white p-7 sm:p-9">
        <h1 class="text-2xl font-semibold tracking-tight text-ink-900">{heading}</h1>
        <p class="mt-2 text-[0.975rem] leading-relaxed text-ink-500">{subheading}</p>
        <slot />
      </div>

      <slot name="footer" />
    </main>
  </body>
</html>
