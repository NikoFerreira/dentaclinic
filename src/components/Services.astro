---
import Icon from './Icon.astro';
import { services } from '../data/site';
---

<section id="servicios" class="section-y" aria-labelledby="servicios-titulo">
  <div class="container-page">
    <header class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-600">Servicios</p>
      <h2
        id="servicios-titulo"
        class="mt-3 text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl"
      >
        Tratamientos para cada etapa de tu salud dental
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-500">
        Todo en un mismo lugar, con presupuesto por escrito antes de comenzar.
      </p>
    </header>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <li class="group flex h-full flex-col rounded-3xl border border-ink-200/80 bg-white p-8 transition-all duration-200 hover:-translate-y-1 hover:border-brand-200 hover:shadow-xl hover:shadow-ink-900/5">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-brand-50 text-brand-600 transition-colors group-hover:bg-brand-100">
              <Icon name={service.icon} class="h-6 w-6" />
            </span>

            <h3 class="mt-6 text-xl font-semibold tracking-tight text-ink-900">{service.title}</h3>
            <p class="mt-3 text-[0.975rem] leading-relaxed text-ink-500">{service.description}</p>

            <ul class="mt-6 space-y-2.5 border-t border-ink-200/70 pt-6">
              {service.items.map((item) => (
                <li class="flex items-center gap-2.5 text-sm font-medium text-ink-700">
                  <Icon name="check" class="h-4 w-4 shrink-0 text-mint-600" strokeWidth={2} />
                  {item}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
