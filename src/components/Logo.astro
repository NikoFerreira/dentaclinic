---
import { site } from '../data/site';

interface Props {
  class?: string;
  tone?: 'dark' | 'light';
}

const { class: className = '', tone = 'dark' } = Astro.props;

const wordmark = tone === 'dark' ? 'text-ink-900' : 'text-white';
const accent = tone === 'dark' ? 'text-brand-600' : 'text-brand-300';
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <span
    class="grid h-9 w-9 place-items-center rounded-xl bg-brand-600 text-white shadow-sm shadow-brand-600/25"
  >
    <svg
      class="h-5 w-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M12 3c-2.1 0-3 1-4.5 1C6.1 4 4.7 3.3 4 4.9c-.7 1.8-.1 4.1.7 6.1.7 1.7.9 2.6 1.1 4.3.2 1.6.3 3.1.7 3.9.4.8 1.4.8 1.8 0 .5-1 .6-2.6.9-4 .2-.9.4-1.4 1-1.4s.8.5 1 1.4c.3 1.4.4 3 .9 4 .4.8 1.4.8 1.8 0 .4-.8.5-2.3.7-3.9.2-1.7.4-2.6 1.1-4.3.8-2 1.4-4.3.7-6.1-.7-1.6-2.1-.9-3.5-.9C15 4 14.1 3 12 3Z"
      ></path>
    </svg>
  </span>
  <span class={`text-lg font-semibold tracking-tight ${wordmark}`}>
    Denta<span class={accent}>Clinic</span>
  </span>
  <span class="sr-only">{site.tagline}</span>
</span>
