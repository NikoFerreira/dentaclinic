---
import Icon from './Icon.astro';
import { stats, trustPoints } from '../data/site';
---

<section id="nosotros" class="bg-white section-y" aria-labelledby="nosotros-titulo">
  <div class="container-page">
    <div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-600">Confianza</p>
        <h2
          id="nosotros-titulo"
          class="mt-3 text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl"
        >
          Tecnología precisa, equipo con experiencia
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-500">
          Combinamos escaneo intraoral 3D y radiografía digital de baja radiación con un equipo que
          acumula más de una década tratando pacientes. Esto significa diagnósticos exactos, menos
          sesiones y resultados predecibles.
        </p>

        <ul class="mt-10 space-y-7">
          {
            trustPoints.map((point) => (
              <li class="flex gap-4">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-mint-50 text-mint-600">
                  <Icon name={point.icon} class="h-5 w-5" />
                </span>
                <div>
                  <h3 class="text-base font-semibold text-ink-900">{point.title}</h3>
                  <p class="mt-1.5 text-[0.975rem] leading-relaxed text-ink-500">
                    {point.description}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:pt-14">
        <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-ink-200/80 bg-ink-200/70">
          {
            stats.map((stat) => (
              /* column-reverse: el numero se ve arriba y el <dt> mantiene el orden valido en el DOM */
              <div class="flex flex-col-reverse bg-white p-7 sm:p-9">
                <dt class="mt-2 text-sm leading-snug text-ink-500">{stat.label}</dt>
                <dd class="text-3xl font-semibold tracking-tight text-brand-600 sm:text-4xl">
                  {stat.value}
                  {stat.unit && (
                    <span
                      class:list={[
                        'text-xl font-medium text-brand-400 sm:text-2xl',
                        !stat.unit.startsWith('/') && 'ml-1.5',
                      ]}
                    >
                      {stat.unit}
                    </span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>

        <figure
          class="mt-6 rounded-3xl border border-ink-200/80 bg-page p-7 sm:p-9"
        >
          <div class="flex gap-0.5 text-mint-600" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => <Icon name="star" class="h-4 w-4 fill-current" />)}
          </div>
          <blockquote class="mt-4 text-[0.975rem] leading-relaxed text-ink-700">
            <p>
              Me explicaron cada paso del tratamiento con el escáner en pantalla. Primera vez que
              salgo del dentista entendiendo exactamente qué me hicieron y por qué.
            </p>
          </blockquote>
          <figcaption class="mt-4 text-sm font-medium text-ink-500">
            Laura M. <span class="text-ink-300">·</span> paciente de ortodoncia
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
