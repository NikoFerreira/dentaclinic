---
import { strokeIcons, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
  id?: string;
}

const { name, class: className = 'h-5 w-5', strokeWidth = 1.5, id } = Astro.props;
---

<svg
  id={id}
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={strokeIcons[name]}
/>
