# ---------------------------------------------------------------------------
# Copiar este archivo como `.env` y completar los valores.
# `.env` esta en .gitignore y NUNCA debe subirse: el repositorio es publico.
# ---------------------------------------------------------------------------

# Conexion que usa la aplicacion en tiempo de ejecucion.
# En Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler"
# (puerto 6543). Es la adecuada para funciones serverless.
DATABASE_URL="postgresql://postgres.xxxxxxxx:CONTRASENA@aws-0-region.pooler.supabase.com:6543/postgres"

# Conexion directa (puerto 5432), usada solo por drizzle-kit para las migraciones.
# El pooler en modo transaction no admite las sentencias DDL que necesitan.
DIRECT_URL="postgresql://postgres.xxxxxxxx:CONTRASENA@aws-0-region.pooler.supabase.com:5432/postgres"

# Credenciales del primer usuario administrador, usadas una sola vez por `npm run db:seed`.
# Elegir una contrasena larga y unica; se guarda hasheada con Argon2id.
ADMIN_EMAIL="admin@dentaclinic.com.py"
ADMIN_PASSWORD=""
ADMIN_NAME="Administracion DentaClinic"
ADMIN_PHONE="+595 21 555 0180"
